# StudyQue — Firestore security rules
#
# Derived from the app's actual data model in src/App.jsx:
# - users/{uid} — profile + counters (totalMaterials, studySessions,
#   completedQuizzes, totalQuizScore, flashcardsCreated, featureUsage.*,
#   createdAt, updatedAt). Created at signup, updated with merge + increment.
# - users/{uid}/materialHistory — { fileNames[], createdAt }
# - users/{uid}/flashcardHistory — flashcard sets saved from transcription
# - users/{uid}/generatedHistory — generated results (summary/quiz/test/chat)
# - sharedResults/{shareId} — public share links { result, mode, language,
#   title, createdAt }. Share IDs are crypto.randomUUID() (122-bit random),
#   so they are unguessable — public read-by-ID is safe ONLY because the ID
#   itself is the secret. There is no list/query access to sharedResults.
#
# IMPORTANT: these rules are NOT live just by being in the repo. They must
# be published in the Firebase Console (Firestore Database -> Rules ->
# publish), and Vercel deploys do not publish them.
#
# NOTE: sharedResults create requires sign-in. A signed-out visitor who
# opens a shared link can read it, but cannot re-share it until they sign
# in — that is intentional, so anonymous users cannot write to Firestore.
#
# NOTE (2026-11-26): the share-result size cap is 200000 characters, not
# 60000 — a long summary/quiz from a big lecture can exceed 60k chars and
# the old cap made sharing fail with a permission error. 200k stays well
# under Firestore's 1 MiB document limit.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PRIVATE USER DATA
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Uploaded material history
      match /materialHistory/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Generated flashcard history (existing)
      match /flashcardHistory/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // All generated content history
      match /generatedHistory/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Study plans (exam planner — local schedules, no AI)
      match /studyPlans/{planId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // PUBLICLY SHAREABLE STUDY RESULTS
    match /sharedResults/{shareId} {

      // Only signed-in users can create share links.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'result',
                      'mode',
                      'language',
                      'title',
                      'createdAt'
                    ])
                    && request.resource.data.result is string
                    && request.resource.data.result.size() > 0
                    && request.resource.data.result.size() <= 200000
                    && request.resource.data.mode is string
                    && request.resource.data.language is string
                    && request.resource.data.title is string
                    && request.resource.data.createdAt == request.time;

      // Anyone with a share link can read that specific result.
      allow get: if true;

      // Prevent listing all shared results.
      allow list: if false;

      // Shared results cannot be edited or deleted by clients.
      allow update, delete: if false;
    }

    // Deny everything else by default (Firestore also denies anything
    // not explicitly allowed; this makes it explicit).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
